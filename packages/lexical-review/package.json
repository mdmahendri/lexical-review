{
  "name": "lexical-review",
  "version": "3.0.0",
  "description": "A custom lexical plugin provides suggestion, review, or track changes mode",
  "keywords": [
    "lexical",
    "suggestion",
    "review",
    "track changes"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.mjs"
      },
      "require": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mahendrimd/lexical-review",
    "directory": "packages/lexical-review"
  },
  "scripts": {
    "build": "node build.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@lexical/clipboard": ">=0.45.0 <0.50.0",
    "@lexical/react": ">=0.45.0 <0.50.0",
    "@lexical/utils": ">=0.45.0 <0.50.0",
    "lexical": ">=0.45.0 <0.50.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@lexical/clipboard": "0.49.0",
    "@lexical/react": "0.49.0",
    "@lexical/utils": "0.49.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "lexical": "0.49.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rolldown": "^1.2.5"
  }
}
